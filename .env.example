# Billbee: API in Einstellungen > Billbee API aktivieren.
# Alle drei Werte sind erforderlich. Niemals VITE_-Variablen fuer Secrets verwenden.
BILLBEE_API_KEY=
BILLBEE_USERNAME=
BILLBEE_API_PASSWORD=

# auto: Demo ohne Zugangsdaten, Live bei vollstaendiger Konfiguration.
# demo: explizit Beispieldaten; live: ausschliesslich echte Daten.
DATA_MODE=auto
PORT=3000
HOST=127.0.0.1
# Automatische Synchronisierung in Minuten; 0 deaktiviert sie.
SYNC_INTERVAL_MINUTES=60

# Debug-Empfaenger fuer ALLE E-Mail-Entwuerfe, auch vorhandene Bestellungen/Fehlmengen.
# Leer = echte Lieferantenadresse. Nach Aenderung den Server neu starten.
EMAIL_DEBUG_RECIPIENT=

# Direktversand per SMTP. Zugangsdaten nur hier auf dem Server hinterlegen.
SMTP_HOST=
SMTP_PORT=587
# false = verschluesseltes STARTTLS (587); true = TLS ab Verbindungsaufbau (465).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME="Jolifill Einkauf"

# Optionaler HTTP-Basic-Schutz (beide Werte setzen).
# Fuer Freigabe im Netzwerk / Hosting HTTPS und Zugriffsschutz einrichten.
APP_USERNAME=
APP_PASSWORD=
